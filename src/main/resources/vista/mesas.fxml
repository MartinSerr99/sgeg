<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sgeg.vista.MesasController" styleClass="principal-raiz">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="barra">
            <Button text="← Volver" styleClass="boton-secundario" onAction="#volver"/>
            <Label text="Mesas y pedidos" styleClass="barra-titulo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnActualizar" text="Actualizar" styleClass="boton-secundario" onAction="#actualizar"/>
            <Button text="Pedido para llevar" styleClass="boton-acento" onAction="#pedidoParaLlevar"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="6">
            <padding>
                <Insets top="28" right="36" bottom="24" left="36"/>
            </padding>
            <Label text="Plano del salón" styleClass="seccion-titulo"/>
            <Label fx:id="lblEstado" styleClass="seccion-ayuda" wrapText="true"/>
            <ScrollPane fitToWidth="true" styleClass="scroll-limpio" VBox.vgrow="ALWAYS">
                <VBox.margin>
                    <Insets top="14"/>
                </VBox.margin>
                <FlowPane fx:id="panelMesas" hgap="16" vgap="16" styleClass="area-transparente">
                    <padding>
                        <Insets top="4" right="4" bottom="4" left="4"/>
                    </padding>
                </FlowPane>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
