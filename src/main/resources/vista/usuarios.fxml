<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sgeg.vista.UsuariosController" styleClass="principal-raiz">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="barra">
            <Button text="← Volver" styleClass="boton-secundario" onAction="#volver"/>
            <Label text="Usuarios y roles" styleClass="barra-titulo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Actualizar" styleClass="boton-secundario" onAction="#actualizar"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="24" right="28" bottom="24" left="28"/>
            </padding>

            <Label text="Un usuario dado de baja no puede iniciar sesión, pero se conserva su historial de pedidos."
                   styleClass="seccion-ayuda" wrapText="true"/>

            <HBox spacing="10">
                <Button text="Nuevo usuario" styleClass="boton-primario" onAction="#nuevo"/>
                <Button fx:id="btnEditar" text="Editar" styleClass="boton-claro" onAction="#editar"/>
                <Button fx:id="btnClave" text="Cambiar contraseña" styleClass="boton-claro" onAction="#cambiarContrasenia"/>
                <Button fx:id="btnEstado" text="Dar de baja" styleClass="boton-claro" onAction="#cambiarEstado"/>
            </HBox>

            <TableView fx:id="tblUsuarios" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNombre" text="Nombre y apellido" prefWidth="260" sortable="false"/>
                    <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="170" sortable="false"/>
                    <TableColumn fx:id="colRol" text="Rol" prefWidth="150" sortable="false"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="140" sortable="false"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
