<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sgeg.vista.InsumosController" styleClass="principal-raiz">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="barra">
            <Button text="← Volver" styleClass="boton-secundario" onAction="#volver"/>
            <Label fx:id="lblTitulo" styleClass="barra-titulo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Actualizar" styleClass="boton-secundario" onAction="#actualizar"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="24" right="28" bottom="24" left="28"/>
            </padding>

            <HBox fx:id="avisoStock" styleClass="aviso-ok">
                <Label fx:id="lblAvisoStock" wrapText="true"/>
            </HBox>

            <HBox fx:id="acciones" spacing="10">
                <Button fx:id="btnIngreso" text="Registrar ingreso de stock" styleClass="boton-primario" onAction="#registrarIngreso"/>
                <Button text="Nuevo insumo" styleClass="boton-claro" onAction="#nuevo"/>
                <Button fx:id="btnEditar" text="Editar" styleClass="boton-claro" onAction="#editar"/>
            </HBox>

            <TableView fx:id="tblInsumos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNombre" text="Insumo" prefWidth="260" sortable="false"/>
                    <TableColumn fx:id="colStock" text="Stock actual" prefWidth="130" sortable="false" styleClass="columna-derecha"/>
                    <TableColumn fx:id="colMinimo" text="Stock mínimo" prefWidth="130" sortable="false" styleClass="columna-derecha"/>
                    <TableColumn fx:id="colUnidad" text="Unidad" prefWidth="100" sortable="false"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="150" sortable="false"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
