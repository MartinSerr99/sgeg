<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sgeg.vista.ProductosController" styleClass="principal-raiz">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="barra">
            <Button text="← Volver" styleClass="boton-secundario" onAction="#volver"/>
            <Label fx:id="lblTitulo" styleClass="barra-titulo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Actualizar" styleClass="boton-secundario" onAction="#actualizar"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="24" right="28" bottom="24" left="28"/>
            </padding>

            <Label fx:id="lblAyuda" styleClass="seccion-ayuda" wrapText="true"/>

            <FlowPane hgap="10" vgap="8" alignment="CENTER_LEFT">
                <Label text="Categoría" styleClass="campo-etiqueta"/>
                <ComboBox fx:id="cmbCategoria" prefWidth="220"/>
                <CheckBox fx:id="chkBajas" text="Mostrar productos dados de baja"/>
            </FlowPane>

            <HBox fx:id="acciones" spacing="10">
                <Button text="Nuevo producto" styleClass="boton-primario" onAction="#nuevo"/>
                <Button fx:id="btnEditar" text="Editar" styleClass="boton-claro" onAction="#editar"/>
                <Button fx:id="btnBaja" text="Dar de baja" styleClass="boton-claro" onAction="#cambiarDisponibilidad"/>
                <Button text="Categorías" styleClass="boton-claro" onAction="#administrarCategorias"/>
            </HBox>

            <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNombre" text="Producto" prefWidth="280" sortable="false"/>
                    <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="170" sortable="false"/>
                    <TableColumn fx:id="colPrecio" text="Precio" prefWidth="120" sortable="false" styleClass="columna-derecha"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="130" sortable="false"/>
                    <TableColumn fx:id="colDisponibles" text="Alcanza para" prefWidth="120" sortable="false" styleClass="columna-derecha"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
