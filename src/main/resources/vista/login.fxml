<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sgeg.vista.LoginController" styleClass="login-raiz">

    <!-- Panel de marca -->
    <VBox styleClass="login-marca" prefWidth="340" minWidth="340" maxWidth="340"
          alignment="BOTTOM_LEFT" spacing="14">
        <padding>
            <Insets top="40" right="36" bottom="44" left="36"/>
        </padding>
        <Label text="SGEG" styleClass="marca-nombre"/>
        <Region styleClass="marca-linea" prefWidth="64" maxWidth="64" prefHeight="4" minHeight="4" maxHeight="4"/>
        <Label text="Pedidos, stock y caja de tu local, en un solo lugar."
               styleClass="marca-lema" wrapText="true"/>
    </VBox>

    <!-- Formulario -->
    <VBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="6">
        <padding>
            <Insets top="40" right="64" bottom="40" left="64"/>
        </padding>

        <Label text="Iniciar sesión" styleClass="form-titulo"/>
        <Label text="Ingresá con la cuenta que te asignó el administrador."
               styleClass="form-ayuda" wrapText="true"/>

        <Label text="Usuario" styleClass="campo-etiqueta">
            <VBox.margin>
                <Insets top="20"/>
            </VBox.margin>
        </Label>
        <TextField fx:id="txtUsuario" onAction="#iniciarSesion"/>

        <Label text="Contraseña" styleClass="campo-etiqueta">
            <VBox.margin>
                <Insets top="10"/>
            </VBox.margin>
        </Label>
        <PasswordField fx:id="txtContrasenia" onAction="#iniciarSesion"/>

        <Label fx:id="lblMensaje" styleClass="mensaje-error" wrapText="true"
               visible="false" managed="false"/>

        <HBox alignment="CENTER_LEFT" spacing="14">
            <padding>
                <Insets top="16"/>
            </padding>
            <Button fx:id="btnIngresar" text="Iniciar sesión" styleClass="boton-primario"
                    onAction="#iniciarSesion"/>
            <ProgressIndicator fx:id="indicador" visible="false" managed="false"
                               prefWidth="22" prefHeight="22" maxWidth="22" maxHeight="22"/>
        </HBox>
    </VBox>
</HBox>
